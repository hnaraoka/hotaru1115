DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# NextAuth: `openssl rand -base64 32` などで生成してください
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
AUTH_TRUST_HOST="true"

# Resend（管理者へのログイン失敗通知メール送信に使用。未設定の場合はメール送信のみスキップされます）
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL="onboarding@resend.dev"

# 提出リマインドの自動送信（Vercel Cron）を使う場合に設定。
# `openssl rand -hex 32` などで生成。Vercel が /api/cron/remind 呼び出し時に
# Authorization: Bearer <CRON_SECRET> を自動付与する。未設定の場合、自動送信は無効。
CRON_SECRET=""

# LINE WORKS Driveへの自動格納（管理者が報告書を承認した際にPDFを自動アップロード）。
# 5つすべてを設定した場合のみ有効になる（未設定時はこの機能だけスキップされる）。
# LINE WORKS Developer Console でAPI 2.0のアプリを作成し、サービスアカウント(JWT Bearer)
# 認証を有効化して発行される値を設定する。
LINEWORKS_CLIENT_ID=""
LINEWORKS_CLIENT_SECRET=""
LINEWORKS_SERVICE_ACCOUNT=""
# 改行を含むPEM形式の秘密鍵。Vercelの環境変数では改行を \n と入力する（アプリ側で復元する）。
LINEWORKS_PRIVATE_KEY=""
# アップロード先のマイドライブを持つLINE WORKSユーザーのID（例: 共有アカウントのユーザーID）
LINEWORKS_DRIVE_USER_ID=""
# アップロード先フォルダID（任意。未設定の場合はマイドライブ直下に格納）
LINEWORKS_DRIVE_FOLDER_ID=""
