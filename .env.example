DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# NextAuth: `openssl rand -base64 32` などで生成してください
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
AUTH_TRUST_HOST="true"

# Resend（管理者へのログイン失敗通知メール送信に使用。未設定の場合はメール送信のみスキップされます）
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL="onboarding@resend.dev"

# 提出リマインドの自動送信（Vercel Cron）を使う場合に設定。
# `openssl rand -hex 32` などで生成。Vercel が /api/cron/remind 呼び出し時に
# Authorization: Bearer <CRON_SECRET> を自動付与する。未設定の場合、自動送信は無効。
CRON_SECRET=""
