generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Report {
  id           String   @id @default(cuid())
  title        String
  year         Int
  month        Int
  author       String
  department   String?
  summary      String?
  achievements String?
  issues       String?
  nextPlan     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([year, month])
}
